    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041B\u0415\u0412\u042B\u0419 \u041A\u041E\u041D\u0422\u0420\u041E\u041B\u041B\u0415\u0420\n\u0421\u0442\u0438\u043A
    \u2014 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043F\u043E
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438\nY \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    / \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043C\u0435\u043D\u044E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432\n\u0422\u0440\u0438\u0433\u0433\u0435\u0440
    \u2014 \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435
    \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435\n\u0421\u0442\u0438\u043A \u0432
    \u043C\u0435\u043D\u044E \u2014 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F;
    \u043A\u043B\u0438\u043A \u0441\u0442\u0438\u043A\u0430 \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\nMenu
    \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C / \u0437\u0430\u043A\u0440\u044B\u0442\u044C
    \u0438\u0433\u0440\u043E\u0432\u043E\u0435 \u043C\u0435\u043D\u044E\n\n\u041F\u0420\u0410\u0412\u042B\u0419
    \u041A\u041E\u041D\u0422\u0420\u041E\u041B\u041B\u0415\u0420\n\u0421\u0442\u0438\u043A
    \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u043A\u0430\u043C\u0435\u0440\u044B;
    \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435\nB
    \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C / \u0437\u0430\u043A\u0440\u044B\u0442\u044C
    \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\n\u0422\u0440\u0438\u0433\u0433\u0435\u0440
    \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
    \u043F\u043E\u0434 \u043B\u0443\u0447\u043E\u043C\nGrip \u2014 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C
    \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
    \u043F\u043E \u0442\u0435\u0440\u0440\u0435\u0439\u043D\u0443\n\u041A\u043B\u0438\u043A
    \u0441\u0442\u0438\u043A\u0430 \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435\n\n\u0412\u044B\u0431\u043E\u0440
    \u043A\u043D\u043E\u043F\u043E\u043A \u0432\u043E \u0432\u0441\u0435\u0445 \u043C\u0435\u043D\u044E
    \u2014 \u043B\u0443\u0447\u043E\u043C \u0438 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u043E\u043C."
  m_isRightToLeft: 0
